{
  "kind": "module",
  "visibility": "open",
  "id": "@canon/inbound",
  "version": "0.1.0",
  "title": "Inbound",
  "description": "Hosted forms that create leads.",
  "author": {"org": "canon"},
  "engines": {"moduleApi": "1"},
  "default": false,
  "nav": {"label": "Inbound", "icon": "inbox", "section": "Work", "landing": "forms"},
  "collections": {
    "forms": {
      "schema": {
        "type": "object",
        "value": {
          "name": {"fieldType": {"type": "string"}, "optional": false},
          "fields": {
            "fieldType": {
              "type": "array",
              "value": {
                "type": "object",
                "value": {
                  "key": {"fieldType": {"type": "string"}, "optional": false},
                  "label": {"fieldType": {"type": "string"}, "optional": false},
                  "kind": {"fieldType": {"type": "string"}, "optional": false},
                  "required": {"fieldType": {"type": "boolean"}, "optional": true},
                  "mapsTo": {"fieldType": {"type": "string"}, "optional": true},
                  "options": {"fieldType": {"type": "array", "value": {"type": "string"}}, "optional": true}
                }
              }
            },
            "optional": false
          },
          "hiddenParams": {"fieldType": {"type": "array", "value": {"type": "string"}}, "optional": true},
          "leadSource": {"fieldType": {"type": "string"}, "optional": true},
          "dailyCap": {"fieldType": {"type": "number"}, "optional": true},
          "message": {"fieldType": {"type": "string"}, "optional": true},
          "redirect": {"fieldType": {"type": "string"}, "optional": true},
          "status": {"fieldType": {"type": "string"}, "optional": false},
          "publicId": {"fieldType": {"type": "string"}, "optional": true},
          "publishedBy": {"fieldType": {"type": "ref", "to": "users"}, "optional": true},
          "publishedAt": {"fieldType": {"type": "number"}, "optional": true},
          "routeToAccountOwner": {"fieldType": {"type": "boolean"}, "optional": true}
        }
      },
      "key": "auto",
      "indexes": {},
      "access": {"manager": "all", "rep": "none", "other": "none"}
    },
    "submissions": {
      "schema": {
        "type": "object",
        "value": {
          "formKey": {"fieldType": {"type": "string"}, "optional": false},
          "answers": {"fieldType": {"type": "string"}, "optional": false},
          "utm": {"fieldType": {"type": "string"}, "optional": false},
          "hidden": {"fieldType": {"type": "string"}, "optional": false},
          "outcome": {"fieldType": {"type": "string"}, "optional": false},
          "receivedAt": {"fieldType": {"type": "number"}, "optional": false},
          "ipHash": {"fieldType": {"type": "string"}, "optional": false},
          "userAgent": {"fieldType": {"type": "string"}, "optional": false},
          "leadId": {"fieldType": {"type": "string"}, "optional": true},
          "personId": {"fieldType": {"type": "string"}, "optional": true},
          "companyId": {"fieldType": {"type": "string"}, "optional": true},
          "accountOwner": {"fieldType": {"type": "string"}, "optional": true},
          "matchUnavailable": {"fieldType": {"type": "boolean"}, "optional": true},
          "assignee": {"fieldType": {"type": "ref", "to": "users"}, "optional": true},
          "resolvedBy": {"fieldType": {"type": "ref", "to": "users"}, "optional": true},
          "resolvedAt": {"fieldType": {"type": "number"}, "optional": true},
          "candidates": {
            "fieldType": {
              "type": "array",
              "value": {
                "type": "object",
                "value": {
                  "object": {"fieldType": {"type": "string"}, "optional": false},
                  "id": {"fieldType": {"type": "string"}, "optional": false},
                  "reason": {"fieldType": {"type": "string"}, "optional": false},
                  "ownerId": {"fieldType": {"type": "string"}, "optional": true},
                  "url": {"fieldType": {"type": "string"}, "optional": true}
                }
              }
            },
            "optional": true
          }
        }
      },
      "key": "auto",
      "indexes": {"byOutcomeReceived": ["outcome", "receivedAt"]},
      "access": {"manager": "all", "rep": "own", "other": "none"},
      "owner": "assignee"
    }
  },
  "views": {
    "forms.all": {"kind": "list", "collection": "forms", "limit": 100, "order": "desc"},
    "forms.one": {"kind": "one", "collection": "forms", "args": {"key": "string"}, "key": {"arg": "key"}},
    "submissions.all": {"kind": "list", "collection": "submissions", "limit": 100, "order": "desc"},
    "submissions.one": {"kind": "one", "collection": "submissions", "args": {"key": "string"}, "key": {"arg": "key"}},
    "submissions.review": {"kind": "list", "collection": "submissions", "index": "byOutcomeReceived", "eq": ["needs_review"], "order": "desc", "limit": 100, "where": {"field": "outcome", "in": ["needs_review"]}}
  },
  "ops": {
    "forms.create": {
      "label": "New form",
      "kind": "create",
      "collection": "forms",
      "fields": ["name", "fields", "hiddenParams", "leadSource", "dailyCap", "message", "redirect", "routeToAccountOwner"],
      "roles": ["admin"],
      "agent": "propose"
    },
    "forms.update": {
      "label": "Save form",
      "kind": "update",
      "collection": "forms",
      "fields": ["name", "fields", "hiddenParams", "leadSource", "dailyCap", "message", "redirect", "routeToAccountOwner"],
      "roles": ["admin"],
      "agent": "propose",
      "guards": [{"when": {"field": "status", "in": ["draft"]}, "message": "Only draft forms can be edited."}]
    },
    "submissions.receive": {
      "label": "Receive submission",
      "kind": "create",
      "collection": "submissions",
      "fields": ["formKey", "answers", "utm", "hidden", "outcome", "receivedAt", "ipHash", "userAgent", "leadId", "personId", "companyId", "accountOwner", "matchUnavailable", "assignee", "candidates"],
      "roles": [],
      "system": true,
      "agent": "allowed",
      "effects": [
        {"notify": [{"doc": "assignee"}], "when": {"truthy": {"doc": "assignee"}}, "message": "A form you route to was submitted", "link": "submissions/:key"},
        {"notify": [{"role": ["admin", "manager"]}], "when": {"field": "outcome", "in": ["needs_review"]}, "message": "A form submission needs review", "link": "submissions/:key"}
      ]
    },
    "submissions.delete": {"label": "Delete submission", "kind": "delete", "collection": "submissions", "roles": ["admin"], "agent": "human", "reason": "Delete the retained answers"},
    "submissions.resolve": {
      "label": "Resolve submission",
      "kind": "update",
      "collection": "submissions",
      "fields": ["outcome", "leadId", "personId", "companyId", "assignee", "resolvedBy", "resolvedAt"],
      "roles": [],
      "system": true,
      "agent": "allowed",
      "guards": [{"when": {"ref": {"collection": "submissions", "key": {"doc": "key"}}, "where": {"field": "outcome", "in": ["needs_review"]}}, "message": "Already resolved"}],
      "effects": [{"notify": [{"doc": "assignee"}], "when": {"truthy": {"doc": "assignee"}}, "message": "A form you route to was submitted", "link": "submissions/:key"}]
    }
  },
  "calls": {
    "publish": {
      "label": "Publish form",
      "roles": ["admin", "manager", "rep", "other"],
      "agent": "human",
      "capability": "dataModel.edit",
      "args": {"type": "object", "value": {"key": {"fieldType": {"type": "string"}, "optional": false}, "expect": {"fieldType": {"type": "number"}, "optional": false}}},
      "reads": {},
      "writes": ["forms"],
      "returns": "value",
      "canon": {"operation": "forms.publish", "then": {"machine": "form", "transition": "publish", "key": "key", "expect": "expect", "input": {}, "args": {"publicId": {"result": "publicId"}}}},
      "reason": "Publishing authorizes anonymous lead creation"
    },
    "resolve": {
      "label": "Resolve submission",
      "roles": ["admin", "manager"],
      "agent": "human",
      "reason": "A person chooses the matching record",
      "args": {
        "type": "object",
        "value": {
          "key": {"fieldType": {"type": "string"}, "optional": false},
          "expect": {"fieldType": {"type": "number"}, "optional": false},
          "action": {
            "fieldType": {"type": "union", "value": [{"type": "literal", "value": "link"}, {"type": "literal", "value": "create"}, {"type": "literal", "value": "dismiss"}]},
            "optional": false
          },
          "candidateId": {"fieldType": {"type": "string"}, "optional": true}
        }
      },
      "reads": {},
      "writes": [],
      "returns": "value",
      "canon": {"operation": "submissions.resolve"}
    }
  },
  "machines": {
    "form": {
      "collection": "forms",
      "field": "status",
      "states": ["draft", "live", "archived"],
      "initial": "draft",
      "transitions": {
        "publish": {
          "label": "Publish",
          "to": "live",
          "roles": ["admin", "manager", "rep", "other"],
          "agent": "human",
          "capability": "dataModel.edit",
          "args": {"type": "object", "value": {"publicId": {"fieldType": {"type": "string"}, "optional": false}}},
          "set": {"publicId": {"arg": "publicId"}, "publishedBy": {"caller": "userId"}, "publishedAt": {"now": "ms"}},
          "from": ["draft"],
          "reason": "A person decides public intake availability"
        },
        "archive": {"label": "Archive", "to": "archived", "roles": ["admin"], "agent": "human", "from": ["live", "draft"], "reason": "A person decides public intake availability"}
      }
    }
  },
  "pages": [
    {
      "path": "forms",
      "title": "Forms",
      "tab": {"label": "Forms", "order": 0},
      "roles": ["admin"],
      "bind": {"forms": {"view": "forms.all"}},
      "body": [
        {"c": "header", "title": "Forms", "actions": [{"op": "forms.create", "then": "forms/:key"}]},
        {
          "c": "table",
          "columns": [{"label": "Name", "value": "{$row.name}"}, {"label": "Status", "value": "{$row.status}"}],
          "rowLink": "forms/:key",
          "empty": "No forms yet.",
          "from": "forms"
        }
      ]
    },
    {
      "path": "forms/:key",
      "title": "Form",
      "roles": ["admin"],
      "bind": {"form": {"view": "forms.one", "args": {"key": {"route": "key"}}}},
      "body": [
        {"c": "header", "title": "{$form.name}"},
        {
          "c": "form",
          "op": "forms.update",
          "fields": [
            {"field": "name", "label": "Name"},
            {"field": "fields", "label": "Fields", "widget": "list"},
            {"field": "hiddenParams", "label": "Hiddenparams", "widget": "list"},
            {"field": "leadSource", "label": "Leadsource"},
            {"field": "dailyCap", "label": "Dailycap"},
            {"field": "message", "label": "Message"},
            {"field": "redirect", "label": "Redirect"},
            {"field": "routeToAccountOwner", "label": "Give leads from known accounts to the account owner"}
          ],
          "from": "form"
        },
        {"c": "actions", "items": [{"call": "publish", "args": {"key": {"bind": "form", "field": "key"}, "expect": {"bind": "form", "field": "version"}}}]},
        {"c": "actions", "machine": "form", "target": "form"},
        {"c": "formLink", "from": "form"},
        {"c": "prose", "text": "Intake pauses if the publisher leaves, loses admin access or cannot create leads."},
        {"c": "prose", "text": "Routing recipe: Lead created; lead source is this form and Owner is empty; assign owner; email the record owner."},
        {"c": "actions", "items": [{"canon": "automations", "label": "Automations"}]}
      ]
    },
    {
      "path": "submissions",
      "title": "Submissions",
      "tab": {"label": "Submissions", "order": 1},
      "roles": ["admin", "manager", "rep"],
      "bind": {"submissions": {"view": "submissions.all"}},
      "body": [
        {"c": "header", "title": "Submissions"},
        {
          "c": "table",
          "columns": [{"label": "Outcome", "value": "{$row.outcome}"}, {"label": "Receivedat", "value": "{$row.receivedAt}"}],
          "rowLink": "submissions/:key",
          "empty": "No submissions yet.",
          "from": "submissions"
        }
      ]
    },
    {
      "path": "submissions/:key",
      "title": "Submission",
      "roles": ["admin", "manager", "rep"],
      "bind": {"submission": {"view": "submissions.one", "args": {"key": {"route": "key"}}}},
      "body": [
        {"c": "header", "title": "Submission"},
        {
          "c": "detail",
          "items": [
            {"label": "formKey", "value": "{$submission.formKey}"},
            {"label": "answers", "value": "{$submission.answers}"},
            {"label": "utm", "value": "{$submission.utm}"},
            {"label": "hidden", "value": "{$submission.hidden}"},
            {"label": "outcome", "value": "{$submission.outcome}"},
            {"label": "receivedAt", "value": "{$submission.receivedAt}"},
            {"label": "ipHash", "value": "{$submission.ipHash}"},
            {"label": "userAgent", "value": "{$submission.userAgent}"},
            {"label": "leadId", "value": "{$submission.leadId}"},
            {"label": "personId", "value": "{$submission.personId}"},
            {"label": "companyId", "value": "{$submission.companyId}"},
            {"label": "accountOwner", "value": "{$submission.accountOwner}"},
            {"label": "matchUnavailable", "value": "{$submission.matchUnavailable}"}
          ]
        },
        {
          "c": "table",
          "from": "submission",
          "rows": "candidates",
          "columns": [{"label": "Object", "value": "{$row.object}"}, {"label": "Reason", "value": "{$row.reason}"}, {"label": "Record", "value": "{$row.id}", "link": {"path": "url"}}],
          "empty": "No stored candidates."
        },
        {
          "c": "actions",
          "roles": ["admin", "manager"],
          "when": {"bind": "submission", "field": "outcome", "in": ["needs_review"]},
          "items": [
            {
              "call": "resolve",
              "label": "Link",
              "args": {"key": {"bind": "submission", "field": "key"}, "expect": {"bind": "submission", "field": "version"}, "action": "link"},
              "fields": [{"field": "candidateId", "label": "Candidate", "options": {"from": "submission", "list": "candidates", "value": "id", "label": "{$item.object}: {$item.reason} ({$item.id})"}}]
            },
            {
              "call": "resolve",
              "label": "Create lead",
              "args": {"key": {"bind": "submission", "field": "key"}, "expect": {"bind": "submission", "field": "version"}, "action": "create"},
              "fields": [{"field": "candidateId", "label": "Candidate", "options": {"from": "submission", "list": "candidates", "value": "id", "label": "{$item.object}: {$item.reason} ({$item.id})"}}]
            },
            {"call": "resolve", "label": "Dismiss", "args": {"key": {"bind": "submission", "field": "key"}, "expect": {"bind": "submission", "field": "version"}, "action": "dismiss"}}
          ]
        },
        {"c": "actions", "items": [{"op": "submissions.delete", "target": "submission"}]}
      ]
    },
    {
      "path": "review",
      "title": "Review",
      "roles": ["admin", "manager"],
      "tab": {"label": "Review", "order": 2},
      "bind": {"submissions": {"view": "submissions.review"}},
      "body": [
        {"c": "header", "title": "Review"},
        {"c": "table", "from": "submissions", "columns": [{"label": "Received", "value": "{$row.receivedAt}"}], "rowLink": "submissions/:key", "empty": "No submissions need review."}
      ]
    }
  ]
}
