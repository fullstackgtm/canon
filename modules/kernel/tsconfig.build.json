{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["*.ts", "tools/*.ts"]
}
