# ============================================================================
# Self-hosted Docker Compose (recommended; see docs/self-hosting.md)
# ============================================================================

# Local email/password authentication (default for self-hosting)
CANON_AUTH=local

# Public origin used for links, sign-in, and callbacks
SITE_URL=http://localhost:3000

# Host loopback port published by docker-compose.yml (keep matching SITE_URL locally)
FRONTEND_PORT=3000

# Release image (ghcr.io/fullstackgtm/canon:<date>) or local build tag
CANON_IMAGE=canon-selfhost:local

# Optional: setup code for creating the first workspace owner at /sign-in.
# Leave empty to let the container generate one on first boot (printed in logs).
CANON_SETUP_CODE=

# Optional: 64-hex-character key that encrypts stored integration credentials.
# Docker auto-generates and persists this in /data/credentials/token_encryption_key.
# Required when deploying outside Docker (e.g., Convex Cloud).
# TOKEN_ENCRYPTION_KEY=

# Optional: external recipe/module runtime (leave empty to use the container's
# built-in loopback workerd runtime on 127.0.0.1:8790).
# RECIPE_RUNTIME_URL=
# RECIPE_RUNTIME_SECRET=

# Record API and MCP rate limits, requests a minute (docs/record-api.md, Rate limits).
# Empty keeps the default shown; 0 turns that limit off.
# CANON_API_TOKEN_READS_PER_MINUTE=600
# CANON_API_TOKEN_WRITES_PER_MINUTE=300
# CANON_API_WORKSPACE_READS_PER_MINUTE=1200
# CANON_API_WORKSPACE_WRITES_PER_MINUTE=600

# ============================================================================
# Optional: Hosted / Convex Cloud & Clerk deployment
# ============================================================================

# Convex Cloud
# NEXT_PUBLIC_CONVEX_URL=
# CONVEX_DEPLOYMENT=
# CONVEX_SITE_URL=
# APP_URL=
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clerk (only needed when CANON_AUTH=clerk)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SECRET=
# CLERK_JWT_ISSUER_DOMAIN=
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Stripe (optional billing)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ============================================================================
# Optional: Integrations (see docs/selfhost-integrations.md)
# ============================================================================

# Salesforce Integration
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=

# HubSpot Integration
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=

# Email logging by BCC or forward (see docs/email-logging.md)
# EMAIL_LOG_DOMAIN=
# EMAIL_LOG_SECRET=
