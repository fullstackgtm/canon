RECORD_SERVICE_TOKEN=          # required, >= 16 chars (generate with: openssl rand -hex 32)
PORT=8787
HOST=0.0.0.0
DATA_DIR=/data                 # workspace files at $DATA_DIR/ws/{wsId}.duckdb, PDL index at $DATA_DIR/shared/
MAX_OPEN=64                    # LRU size of open workspace files
WS_MEMORY_LIMIT=512MB          # DuckDB memory_limit per open workspace
WS_THREADS=2
READ_POOL=4                    # read connections per open workspace
MAX_GROUP=64                   # writes per group commit
CHECKPOINT_INTERVAL_MS=60000
# Backups (Cloudflare R2 / any S3). All four required to enable; otherwise backups are DISABLED with a loud warning.
BACKUP_S3_ENDPOINT=            # e.g. https://<account>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
BACKUP_PREFIX=record-service/
BACKUP_INTERVAL_HOURS=24
ALLOW_CRASH_ENDPOINT=0         # 1 enables POST /admin/crash for durability tests only
# Object-layer projector (CP1f). Set both to enable; the service then pulls Convex's ledger feed.
PROJECTOR_POLL_MS=30000        # catch up workspaces active in the last 15 minutes this often; 0 disables
