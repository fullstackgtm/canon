{
  "name": "@fullstackgtm/prospect-index",
  "private": true,
  "type": "module",
  "description": "Shared prospect index (PDL free company dataset) built into DuckDB and queried by the record service.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build:index": "node --experimental-strip-types src/build.ts",
    "test": "node ../../scripts/dev/node-test.mjs --default-concurrency=auto -- test/*.test.ts",
    "bench": "node --experimental-strip-types src/bench.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.6-r.1",
    "@aws-sdk/client-s3": "^3.700.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}