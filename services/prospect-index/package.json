{
  "name": "@fullstackgtm/prospect-index",
  "private": true,
  "type": "module",
  "description": "Shared prospect index (PDL free company dataset) built into DuckDB and queried by the record service.",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build:index": "node --experimental-strip-types src/build.ts",
    "test": "node --experimental-strip-types --test ${CANONCRM_TEST_CONCURRENCY:+--test-concurrency=$CANONCRM_TEST_CONCURRENCY} test/*.test.ts",
    "bench": "node --experimental-strip-types src/bench.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.6-r.1",
    "@aws-sdk/client-s3": "^3.700.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "^22.0.0"
  }
}
