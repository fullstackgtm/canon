# syntax=docker/dockerfile:1
# precompiled-2026-09-21-0cf49cb, matching the local stack's backend release.
FROM ghcr.io/convex/convex-backend:0cf49cbf8c4b7e22e631ceda9b5111f6cccbcd49@sha256:b756b06641d15a55b5ec0692897ce5ad3715ddccfd02e1e213621e9e764255c8 AS convex
FROM public.ecr.aws/docker/library/node:22-bookworm-slim AS node

FROM node AS build
RUN apt-get update && apt-get install -y --no-install-recommends python3 procps && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY services/record-service/package*.json ./services/record-service/
RUN npm ci --prefix services/record-service --omit=dev --no-audit --no-fund
COPY . .
# What the entrypoint compares to decide whether the functions need pushing (scripts/selfhost/functions.mjs).
RUN find . -name node_modules -prune -o -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum | sha256sum | cut -d" " -f1 > .source-sha256
ARG CANON_AUTH=local
ENV CANON_AUTH=$CANON_AUTH
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ENV NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_CANON_SELFHOST=true
RUN npm run build && rm -rf .next/cache .next/standalone && npm prune --omit=dev --no-audit --no-fund

FROM ubuntu:24.04 AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends libclang1 ca-certificates curl openssl tini procps libatomic1 && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local /usr/local
COPY --from=convex /convex/convex-local-backend /convex/generate_key /convex/run_backend.sh /convex/read_credentials.sh /convex/generate_admin_key.sh /convex/
RUN chmod 755 /convex/* && useradd --uid 1001 --create-home canon && mkdir /data && chown canon:canon /data
WORKDIR /app
COPY --from=build --chown=canon:canon /app /app
ARG RELEASE_GIT_SHA
LABEL org.opencontainers.image.revision=$RELEASE_GIT_SHA
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 DISABLE_BEACON=true DO_NOT_TRACK=1
ENV RELEASE_GIT_SHA=$RELEASE_GIT_SHA APP_ENVIRONMENT=selfhost CANON_AUTH=local NEXT_PUBLIC_CANON_SELFHOST=true
VOLUME ["/data"]
EXPOSE 3000 3210 3211
HEALTHCHECK --interval=5s --timeout=5s --start-period=180s --retries=3 CMD ["node", "scripts/selfhost/health.mjs"]
ENTRYPOINT ["/usr/bin/tini", "-g", "--", "node", "--experimental-strip-types", "--no-warnings", "scripts/selfhost/entrypoint.mjs"]
